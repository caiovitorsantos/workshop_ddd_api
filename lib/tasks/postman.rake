# Exports swagger/v1/swagger.yaml (generated by the request specs) as a Postman
# collection, so the API can be exercised without the Swagger UI — e.g. after
# the lab's load balancer is gone.
#
#   bundle exec rake rswag:specs:swaggerize postman:export
#
# Request bodies are filled from the schemas' `example` values. Two scripts
# make the collection usable end to end: logging in stores the JWT in
# {{bearerToken}}, and the quote webhook signs its body with {{webhookSecret}}.
namespace :postman do
  desc "Write postman/oficina-api.postman_collection.json from the Swagger file"
  task :export do
    require "yaml"
    require "json"

    spec = YAML.load_file(Rails.root.join("swagger/v1/swagger.yaml"))

    sample = lambda do |schema|
      next schema["example"] if schema.key?("example")

      case schema["type"]
      when "object"  then (schema["properties"] || {}).transform_values { |s| sample.call(s) }
      when "array"   then [ sample.call(schema["items"] || {}) ]
      when "integer" then schema.fetch("default", 1)
      when "boolean" then true
      else schema.fetch("default", schema["enum"]&.first || "")
      end
    end

    scripts = {
      [ "post", "/api/v1/session" ] => [ "test", [
        "// Saves the JWT for every other request.",
        "if (pm.response.code === 200) {",
        "  pm.collectionVariables.set('bearerToken', pm.response.json().token);",
        "}"
      ] ],
      [ "post", "/api/v1/webhooks/quote_decisions" ] => [ "prerequest", [
        "// X-Signature = hex HMAC-SHA256 of the exact body, under the shared secret.",
        "const secret = pm.collectionVariables.get('webhookSecret');",
        "pm.variables.set('signature', CryptoJS.HmacSHA256(pm.request.body.raw, secret).toString(CryptoJS.enc.Hex));"
      ] ]
    }

    folders = Hash.new { |hash, tag| hash[tag] = { name: tag, item: [] } }

    spec["paths"].each do |path, operations|
      shared = operations.fetch("parameters", [])

      operations.except("parameters").each do |method, op|
        params = shared + op.fetch("parameters", [])
        segments = path.delete_prefix("/").split("/").map { |s| s.sub(/\A\{(.+)\}\z/, ':\1') }

        request = {
          method: method.upcase,
          header: params.select { |p| p["in"] == "header" }.map do |p|
            { key: p["name"], value: p["name"] == "X-Signature" ? "{{signature}}" : "" }
          end,
          url: {
            raw: "{{baseUrl}}#{path.gsub(/\{(\w+)\}/, ':\1')}",
            host: [ "{{baseUrl}}" ],
            path: segments,
            variable: params.select { |p| p["in"] == "path" }.map { |p| { key: p["name"], value: p["example"] || "1" } },
            query: params.select { |p| p["in"] == "query" }.map { |p| { key: p["name"], value: "", disabled: true } }
          },
          auth: op["security"] ? { type: "bearer", bearer: [ { key: "token", value: "{{bearerToken}}", type: "string" } ] } : { type: "noauth" }
        }

        if (schema = op.dig("requestBody", "content", "application/json", "schema"))
          request[:header] << { key: "Content-Type", value: "application/json" }
          request[:body] = { mode: "raw", raw: JSON.pretty_generate(sample.call(schema)) }
        end

        item = { name: op["summary"], request: request }
        if (listen, exec = scripts[[ method, path ]])
          item[:event] = [ { listen: listen, script: { type: "text/javascript", exec: exec } } ]
        end

        folders[op.fetch("tags", [ "Other" ]).first][:item] << item
      end
    end

    collection = {
      info: {
        name: "Oficina API",
        description: "Generated from swagger/v1/swagger.yaml by `rake postman:export`. " \
                     "Set baseUrl to the load balancer in the cluster; run Authentication first.",
        schema: "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      variable: [
        { key: "baseUrl", value: spec.dig("servers", 0, "url") },
        { key: "bearerToken", value: "" },
        { key: "webhookSecret", value: "development-only-webhook-secret" }
      ],
      item: folders.values
    }

    out = Rails.root.join("postman/oficina-api.postman_collection.json")
    FileUtils.mkdir_p(out.dirname)
    File.write(out, JSON.pretty_generate(collection) + "\n")
    puts "#{out.relative_path_from(Rails.root)}: #{folders.values.sum { |f| f[:item].size }} requests"
  end
end
