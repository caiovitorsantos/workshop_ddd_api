# Copy to .env and adjust. docker-compose.yml reads these; every variable has a
# working default, so `docker compose up` works with no .env at all.

# --- Database ---------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=oficina_api_development

# --- Authentication ---------------------------------------------------------
# Signing key for the administrative JWTs. Required in production; development
# and test fall back to Rails' secret_key_base.
# Generate one with: bin/rails secret
JWT_SECRET=development-only-secret

# Shared secret of the quote-decision webhook (POST /api/v1/webhooks/quote_decisions).
# The caller sends X-Signature = hex HMAC-SHA256 of the raw body under it. With
# no secret set, every webhook call is refused.
QUOTE_WEBHOOK_SECRET=development-only-webhook-secret

# --- Customer e-mail (status notifications) ---------------------------------
# Plain SMTP, Mailpit locally and in the cluster (UI on :8025). Jobs run on
# Solid Queue in the primary database: start the worker with `bin/jobs`.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=oficina@oficina.test
# Base of the tracking link written in each e-mail.
PUBLIC_URL=http://localhost:3000

# --- API --------------------------------------------------------------------
# Comma-separated CORS allowlist. Never "*" — that would let any site call this
# API with a signed-in user's token.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

RAILS_MAX_THREADS=5

# Password given to every seeded user (bin/rails db:seed).
SEED_PASSWORD=oficina123
