              "query": []
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gerente@oficina.local\",\n  \"password\": \"oficina123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves the JWT for every other request.",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('bearerToken', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        }
