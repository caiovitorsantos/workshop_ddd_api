            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_number\": \"OS-000042\",\n  \"decision\": \"approved\",\n  \"reason\": \"Preço acima do esperado\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// X-Signature = hex HMAC-SHA256 of the exact body, under the shared secret.",
                  "const secret = pm.collectionVariables.get('webhookSecret');",
                  "pm.variables.set('signature', CryptoJS.HmacSHA256(pm.request.body.raw, secret).toString(CryptoJS.enc.Hex));"
                ]
              }
            }
          ]
        }
      ]
