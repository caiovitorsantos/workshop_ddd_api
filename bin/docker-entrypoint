#!/bin/bash -e

# Development only: docker-compose keeps the gems in a named volume, which
# shadows the ones baked into the image — so after a Gemfile change the volume
# is stale. Install whatever is missing before anything boots Bundler.
if [[ "${RAILS_ENV}" != "production" ]]; then
  bundle check >/dev/null || bundle install
fi

# Development only: create the database if missing and run pending migrations
# before the server starts. "server" is matched anywhere in the arguments so it
# covers `bin/rails server -b 0.0.0.0 -p 3000` and `bin/thrust bin/rails server`.
#
# Production never migrates here. In the cluster several replicas start at
# once and must not race each other on the schema; migrations run once, as a
# Kubernetes Job (`bin/rails db:migrate`), before the new pods roll out.
if [[ "${RAILS_ENV}" != "production" && " $* " == *" server "* ]]; then
  ./bin/rails db:prepare
fi

exec "${@}"
